# Ключ The Odds API: https://the-odds-api.com (бесплатный план ~500 запросов/мес)
# Если ключ пустой — приложение работает на демо-данных.
ODDS_API_KEY=

# Регионы букмекеров (eu включает Pinnacle)
ODDS_REGIONS=eu

# Букмекер по умолчанию в таблице
DEFAULT_BOOKMAKER=pinnacle

# Сколько секунд кэшировать ответы API (экономия квоты)
CACHE_TTL_SECONDS=120

# --- Отслеживание движения Pinnacle ---
# Лиги по умолчанию (потом меняются в UI, вкладка «Лиги»)
TRACK_SPORTS=soccer_epl
# Расписание (каждый опрос = 1 запрос квоты на лигу):
# обычно раз в POLL_BASE_HOURS, а если матч лиги начнётся в ближайшие NEAR_KICKOFF_HOURS — раз в POLL_NEAR_HOURS
POLL_BASE_HOURS=3
POLL_NEAR_HOURS=1
NEAR_KICKOFF_HOURS=8
# Остановить опрос, если квоты осталось меньше
MIN_QUOTA_REMAINING=10
# База SQLite
DB_PATH=data/odds.sqlite
